EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Local testing only: shows an email+password form on the sign-in screen. Never set in release builds.
EXPO_PUBLIC_DEV_PASSWORD_LOGIN=0
# Web push reminders: the public half of the VAPID key pair (the private half goes in Supabase secrets, see docs/APP.md)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# 1 shows "Continue with Google" once Google is enabled in Supabase Auth
EXPO_PUBLIC_GOOGLE_SIGNIN=0
