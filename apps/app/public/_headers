/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The service worker and the page itself must always be re-checked so a new release reaches users.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Expo names these files by content hash, so they can be cached for good.
/_expo/static/*
  Cache-Control: public, max-age=31536000, immutable
